{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "x86-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x86", "strategy": "external" },
      "toolset": { "value": "host=x86", "strategy": "external" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x86-Release",
      "displayName": "x86 Release",
      "inherits": "x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "x86-Debug",
      "displayName": "x86 Debug",
      "inherits": "x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "Release", "configurePreset": "x86-Release" },
    { "name": "Debug", "configurePreset": "x86-Debug" },
    { "name": "Release-mod", "configurePreset": "x86-Release", "targets": ["inventory_mod"] },
    { "name": "Release-tests", "configurePreset": "x86-Release", "targets": ["inventory_tests"] }
  ]
}
